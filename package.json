{
    "name": "element-plus",
    "repository": "https://github.com/noxussj2/element-plus",
    "icon": "images/element-plus.png",
    "displayName": "Element Plus",
    "description": "Element Plus Snippets",
    "version": "3.0.1",
    "engines": {
        "vscode": "^1.46.0"
    },
    "categories": [
        "Snippets"
    ],
    "keywords": [
        "element-plus",
        "element",
        "vue",
        "vue3",
        "snippets",
        "autocomplete"
    ],
    "activationEvents": [
        "onLanguage:html",
        "onLanguage:vue"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "snippets": [
            {
                "language": "vue",
                "path": "./snippets/template.code-snippets"
            },
            {
                "language": "html",
                "path": "./snippets/template.code-snippets"
            }
        ]
    },
    "scripts": {
        "build": "npx vsce package",
        "vscode:prepublish": "yarn run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "yarn run compile && yarn run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.9",
        "@types/node": "20.x",
        "@types/vscode": "^1.46.0",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.7.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.13.0",
        "typescript": "^5.6.3"
    },
    "dependencies": {
        "vscode-html-languageservice": "^5.3.1"
    },
    "publisher": "noxussj",
    "license": "MIT"
}
