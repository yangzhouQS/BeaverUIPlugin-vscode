{
    "name": "beaver-ui",
    "displayName": "Beaver UI",
    "description": "Beaver UI Snippets — @cs/beaver-ui 组件库代码补全与文档提示（属性/事件/插槽/枚举值/指令）",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/yangzhouQS/BeaverUIPlugin-vscode.git"
    },
    "icon": "images/beaver-ui.png",
    "engines": {
        "vscode": "^1.46.0"
    },
    "categories": [
        "Snippets"
    ],
    "keywords": [
        "beaver-ui",
        "beaver",
        "vue",
        "vue3",
        "snippets",
        "autocomplete",
        "element-plus"
    ],
    "activationEvents": [
        "onLanguage:html",
        "onLanguage:vue"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "snippets": [
            {
                "language": "vue",
                "path": "./snippets/template.code-snippets"
            },
            {
                "language": "html",
                "path": "./snippets/template.code-snippets"
            }
        ]
    },
    "scripts": {
        "build": "npx vsce package",
        "vscode:prepublish": "yarn run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "yarn run compile && yarn run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "verify": "node scripts/verify.mjs",
        "generate": "node scripts/generate-data.mjs && node scripts/generate-snippets.mjs --skip-upstream"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.9",
        "@types/node": "20.x",
        "@types/vscode": "^1.46.0",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.7.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.13.0",
        "typescript": "^5.6.3"
    },
    "publisher": "yearrow",
    "license": "MIT"
}
